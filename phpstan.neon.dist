includes:
	- phpstan-baseline.neon
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5

	# The plugin supports PHP 8.0 (composer.json, plugin header, readme).
	# Analysing with 8.0 grammar turns 8.1+ syntax into parse errors and
	# 8.1+ functions (array_is_list, …) into unknown functions. Do not remove.
	phpVersion:
		min: 80000
		max: 80599

	paths:
		- lw-slider.php
		- uninstall.php
		- includes/

	excludePaths:
		- tests/
		- vendor/

	# Declare the plugin's runtime-defined constants for static analysis.
	bootstrapFiles:
		- phpstan-bootstrap.php

	# The WordPress stub symbol table is large; a single worker keeps peak
	# memory deterministic under the `analyse` script's limit.
	parallel:
		maximumNumberOfProcesses: 1
